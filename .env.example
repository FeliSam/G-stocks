# ==============================================================================
# G-STOCK — VARIABLES D'ENVIRONNEMENT (.env.example)
# ==============================================================================
# Copiez ce fichier vers .env à la racine et dans packages/database/.env
# Aucun secret réel ne doit être commité dans Git.

NODE_ENV=development

# --- Base de données PostgreSQL ---
# En développement local avec `pnpm db:local:start`, le cluster PostgreSQL 18
# écoute sur le port 5433 sans mot de passe externe requis, ou utilisez Docker sur 5432.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/gstock?schema=public"

# --- Serveur API (apps/api) ---
API_PORT=4000
API_HOST=localhost
CORS_ORIGIN="http://localhost:3000"

# --- Sécurité & Sessions ---
# Générer avec : openssl rand -hex 32
JWT_SECRET="change-me-in-production-use-at-least-32-chars-random-secret-key"
JWT_EXPIRES_IN="8h"
COOKIE_SECURE="false"

# --- Frontend Web (apps/web) ---
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_APP_NAME="G-Stock"

# --- Stockage Fichiers (Logos & Médias) ---
STORAGE_DRIVER="local"
LOCAL_STORAGE_PATH="./uploads"

# --- Facturation SaaS (BillingProvider) ---
# Valeurs supportées : "simulated_dev" (développement explicite) | "stripe"
BILLING_PROVIDER="simulated_dev"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
